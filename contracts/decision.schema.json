{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberScientist Brain Decision",
  "description": "Validate structure, then validate authority, current state, references, action combinations and budgets in the controller.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "start_trial"
              },
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "success_check": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "goal",
              "success_check"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "steer"
              },
              "trial_id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "trial_id",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "wait"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "pause"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "refresh_platform"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "request_submission"
              },
              "trial_id": {
                "type": "string",
                "minLength": 1
              },
              "bundle_manifest_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "trial_id",
              "bundle_manifest_ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "promote_experience"
              },
              "experience_id": {
                "type": "string",
                "minLength": 1
              },
              "revision_hash": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "op",
              "experience_id",
              "revision_hash",
              "reason",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "finish"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "experience_proposals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "global",
              "challenge"
            ]
          },
          "challenge_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body_md": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "description": "更新已有经验条目的 id；缺省=新建。冲突语义=追加新修订"
          },
          "kind": {
            "enum": [
              "heuristic",
              "procedure",
              "failure",
              "platform"
            ]
          }
        },
        "required": [
          "scope",
          "challenge_id",
          "title",
          "body_md",
          "applicability",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "global"
                }
              }
            },
            "then": {
              "properties": {
                "challenge_id": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "challenge_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "observed_state_version",
    "summary",
    "evidence_refs",
    "actions",
    "experience_proposals"
  ],
  "additionalProperties": false
}
