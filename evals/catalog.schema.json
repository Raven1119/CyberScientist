{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberScientist evaluation catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "challenges"],
  "properties": {
    "schema_version": {"const": "cyberscientist-eval-catalog/v1"},
    "challenges": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["challenge_id", "platform_challenge_id", "title", "tier", "included",
                     "science_scorer", "evaluation_difficulty", "expected_run_cost",
                     "public_score_distribution", "historical_best", "selection_reason"],
        "properties": {
          "challenge_id": {"type": "string", "minLength": 3},
          "platform_challenge_id": {"type": "string", "minLength": 3},
          "title": {"type": "string", "minLength": 3},
          "tier": {"enum": ["fast", "hard"]},
          "included": {"type": "boolean"},
          "science_scorer": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "directory", "evidence_refs", "limitations"],
            "properties": {
              "status": {"enum": ["receipt_validated", "spec_validated", "unavailable"]},
              "directory": {"type": ["string", "null"]},
              "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
              "limitations": {"type": "string", "minLength": 3}
            }
          },
          "evaluation_difficulty": {
            "type": "object", "additionalProperties": false,
            "required": ["cpu_cores", "estimated_minutes", "basis"],
            "properties": {
              "cpu_cores": {"type": ["integer", "null"], "minimum": 1},
              "estimated_minutes": {"type": ["number", "null"], "minimum": 0},
              "basis": {"type": "string", "minLength": 3}
            }
          },
          "expected_run_cost": {
            "type": "object", "additionalProperties": false,
            "required": ["wall_minutes_range", "job_limit", "sandbox_minutes_limit",
                         "model_tokens", "bohrium_amount", "basis"],
            "properties": {
              "wall_minutes_range": {"type": "array", "prefixItems": [
                {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}],
                "minItems": 2, "maxItems": 2},
              "job_limit": {"type": "integer", "minimum": 0},
              "sandbox_minutes_limit": {"type": "integer", "minimum": 0},
              "model_tokens": {"type": "null"},
              "bohrium_amount": {"type": "null"},
              "basis": {"type": "string", "minLength": 3}
            }
          },
          "public_score_distribution": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "source", "sample_count", "min", "median", "max", "full_score_count", "notes"],
            "properties": {
              "status": {"enum": ["leaderboard_snapshot", "unavailable"]},
              "source": {"type": "string", "minLength": 3},
              "sample_count": {"type": ["integer", "null"], "minimum": 0},
              "min": {"type": ["number", "null"]},
              "median": {"type": ["number", "null"]},
              "max": {"type": ["number", "null"]},
              "full_score_count": {"type": ["integer", "null"], "minimum": 0},
              "notes": {"type": "string", "minLength": 3}
            }
          },
          "historical_best": {
            "type": "object", "additionalProperties": false,
            "required": ["display_score", "source", "notes"],
            "properties": {
              "display_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
              "source": {"type": "string", "minLength": 3},
              "notes": {"type": "string"}
            }
          },
          "selection_reason": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
